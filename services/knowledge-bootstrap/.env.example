# Separate database on the existing Postgres instance. Driver prefix is required.
KNOWLEDGE_DATABASE_URL=postgresql+psycopg://knowledge:change-me@localhost:5432/knowledge_bootstrap
# owner/workspace -> bearer token; distinct tokens, at least 16 characters each.
KNOWLEDGE_AUTH_TOKENS={"local":"local-knowledge-dev-token"}
KNOWLEDGE_LOG_LEVEL=INFO
KNOWLEDGE_DATABASE_POOL_SIZE=5
KNOWLEDGE_DATABASE_TIMEOUT_SECONDS=5
KNOWLEDGE_MAX_REQUEST_BYTES=1048576
KNOWLEDGE_MAX_INPUT_BYTES=524288
KNOWLEDGE_MAX_NORMALIZED_BYTES=2097152
KNOWLEDGE_MAX_PARSE_DEPTH=32
KNOWLEDGE_MAX_PARSE_NODES=10000
KNOWLEDGE_MAX_YAML_ALIASES=32
KNOWLEDGE_TEXT_WORKER_ENABLED=true
KNOWLEDGE_WORKER_POLL_SECONDS=1
KNOWLEDGE_QDRANT_URL=http://localhost:6333
KNOWLEDGE_QDRANT_COLLECTION=knowledge_chunks
KNOWLEDGE_EMBEDDING_DIMENSIONS=1536
