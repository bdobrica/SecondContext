# Separate database on the existing Postgres instance. Driver prefix is required.
KNOWLEDGE_DATABASE_URL=postgresql+psycopg://knowledge:change-me@localhost:5432/knowledge_bootstrap
# owner/workspace -> bearer token; distinct tokens, at least 16 characters each.
KNOWLEDGE_AUTH_TOKENS={"local":"local-knowledge-dev-token"}
KNOWLEDGE_LOG_LEVEL=INFO
KNOWLEDGE_DATABASE_POOL_SIZE=5
KNOWLEDGE_DATABASE_TIMEOUT_SECONDS=5
KNOWLEDGE_MAX_REQUEST_BYTES=10485760
KNOWLEDGE_MAX_INPUT_BYTES=524288
KNOWLEDGE_MAX_FILE_BYTES=8388608
KNOWLEDGE_PARSER_TIMEOUT_SECONDS=15
KNOWLEDGE_PARSER_MEMORY_BYTES=536870912
KNOWLEDGE_MAX_PDF_PAGES=500
KNOWLEDGE_MIN_PDF_TEXT_CHARS=20
KNOWLEDGE_MAX_PDF_STREAM_BYTES=8388608
KNOWLEDGE_MAX_DOCUMENT_OBJECTS=50000
KNOWLEDGE_MAX_ARCHIVE_MEMBERS=512
KNOWLEDGE_MAX_DECOMPRESSED_BYTES=33554432
KNOWLEDGE_MAX_COMPRESSION_RATIO=200
KNOWLEDGE_MAX_NORMALIZED_BYTES=2097152
KNOWLEDGE_MAX_PARSE_DEPTH=32
KNOWLEDGE_MAX_PARSE_NODES=10000
KNOWLEDGE_MAX_YAML_ALIASES=32
KNOWLEDGE_TEXT_WORKER_ENABLED=true
KNOWLEDGE_WORKER_POLL_SECONDS=1
# Website fetching uses only public HTTP/HTTPS on default ports; no private-network override.
KNOWLEDGE_WEB_REQUEST_TIMEOUT_SECONDS=10
KNOWLEDGE_WEB_CRAWL_TIMEOUT_SECONDS=120
KNOWLEDGE_WEB_MAX_RESPONSE_BYTES=2097152
KNOWLEDGE_WEB_MAX_REDIRECTS=5
KNOWLEDGE_WEB_MAX_PAGES=20
KNOWLEDGE_WEB_MAX_DEPTH=3
KNOWLEDGE_WEB_MAX_LINKS=1000
KNOWLEDGE_WEB_MAX_OUTPUT_BYTES=8388608
KNOWLEDGE_WEB_CRAWL_DELAY_SECONDS=1
KNOWLEDGE_WEB_MIN_TEXT_CHARS=40
KNOWLEDGE_QDRANT_URL=http://localhost:6333
KNOWLEDGE_QDRANT_COLLECTION=knowledge_chunks
KNOWLEDGE_EMBEDDING_DIMENSIONS=1536

# K5 chunking runs locally; disable indexing to inspect chunks without external backends.
KNOWLEDGE_CHUNK_TARGET_TOKENS=600
KNOWLEDGE_CHUNK_MAX_TOKENS=1200
KNOWLEDGE_CHUNK_OVERLAP_TOKENS=40
KNOWLEDGE_MAX_CHUNKS_PER_SOURCE=5000
KNOWLEDGE_INDEXING_ENABLED=true
KNOWLEDGE_INDEX_BATCH_SIZE=32
KNOWLEDGE_INDEX_TIMEOUT_SECONDS=10
KNOWLEDGE_INDEX_SOURCE_TIMEOUT_SECONDS=120
# Separate credentials/configuration; no automatic inheritance from SecondContext.
KNOWLEDGE_EMBEDDING_BASE_URL=https://api.openai.com/v1
KNOWLEDGE_EMBEDDING_API_KEY=
KNOWLEDGE_EMBEDDING_MODEL=text-embedding-3-small
# Optional: only set for a provider/model supporting output-dimension requests.
# KNOWLEDGE_EMBEDDING_REQUEST_DIMENSIONS=1536
# KNOWLEDGE_QDRANT_API_KEY=

# K6 retrieval bounds; candidates are fetched per requested vector mode.
KNOWLEDGE_SEARCH_MAX_LIMIT=20
KNOWLEDGE_SEARCH_CANDIDATE_LIMIT=100
KNOWLEDGE_SEARCH_TIMEOUT_SECONDS=20

# K10 explicit extraction API only; no ingestion/response-generation dependency.
KNOWLEDGE_EXTRACTION_ENABLED=false
KNOWLEDGE_EXTRACTION_BASE_URL=https://api.openai.com/v1
KNOWLEDGE_EXTRACTION_API_KEY=
KNOWLEDGE_EXTRACTION_MODEL=gpt-4.1-mini
KNOWLEDGE_EXTRACTION_TIMEOUT_SECONDS=30
KNOWLEDGE_EXTRACTION_MAX_CHUNKS=20
KNOWLEDGE_EXTRACTION_MAX_INPUT_BYTES=131072
